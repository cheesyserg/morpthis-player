.DS_Store

# ccache, as the CI workflow keeps it inside the workspace.
.ccache/

# apt's package lists and .deb files, as the CI workflow keeps them inside the
# workspace (RUNNER_TEMP is not traversable by apt's _apt user).
.apt/

morpthis-player/morpthis_player
morpthis-player/morpthis_player_debug
morpthis-player/morpthis_player_host
morpthis-player/morpthis_launch

morpthis-player/build_target
morpthis-player/build_host
morpthis-player/build_gen

# The streaming keys: in the clear, the key that seals them, and the sealed
# file, which only a player built with that key can open.
streaming-keys.ini
streaming-keys.key
streaming-keys.bin

morpthis-player/audio-target

morpthis-player/compile_commands.json
morpthis-player/rockbox-toolchain

morpthis-player/lvgl/
# The LVGL checkout, as a symlink to wherever it was cloned.
morpthis-player/lvgl
morpthis-player/opus-1.4/
morpthis-player/wavpack-*
morpthis-player/opusfile-*
morpthis-player/libogg-*
morpthis-player/freetype-*

morpthis-player/opus-1.4.tar.gz
morpthis-player/opusfile-0.12.tar.gz
morpthis-player/wavpack-5.6.0.tar.bz2
morpthis-player/libogg-1.3.5.tar.gz
morpthis-player/freetype-2.13.3.tar.xz

morpthis-packer/r3proii.upt
morpthis-packer/r1.upt
morpthis-packer/v1.upt
morpthis-packer/v1_md5.txt
morpthis-packer/morpthis_player
morpthis-packer/r3proii_original.upt
morpthis-packer/r1_original.upt
morpthis-packer/v1_original.upt
morpthis-packer/v1_md5_original.txt
morpthis-packer/morpthis_launch
morpthis-packer/boot-script-report.txt

# Optional, device-local Subsonic account (contains a password).
subsonic-credentials.json
subsonic-credentials.json.tmp
